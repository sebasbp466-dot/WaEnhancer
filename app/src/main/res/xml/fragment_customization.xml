            android:max="60"
            app:dependency="modx_liquid"
            app:key="modx_liquid_tint"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_tint" />

        <SeekBarPreference
            android:defaultValue="25"
            android:max="100"
            app:dependency="modx_liquid"
            app:key="modx_liquid_disp"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_disp" />

        <SeekBarPreference
            android:defaultValue="70"
            android:max="100"
            app:dependency="modx_liquid"
            app:key="modx_liquid_rim"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_rim" />

        <SeekBarPreference
            android:defaultValue="140"
            android:max="200"
            app:dependency="modx_liquid"
            app:key="modx_liquid_sat"
            app:min="100"
            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_sat" />

        <ListPreference
            app:defaultValue="auto"
            app:dependency="modx_liquid"
            app:entries="@array/modx_glass_mode_entries"
            app:entryValues="@array/modx_glass_mode_values"
            app:key="modx_glass_mode"
            app:summary="%s"
            app:title="@string/modx_glass_mode" />

        <com.wmods.wppenhacer.preference.FeatureColorPreferenceCompat
            app:cpv_showAlphaSlider="true"
            app:dependency="modx_liquid"
            app:icon="@drawable/ic_customization_palette_24"
            app:key="modx_glass_color"
            app:summary="@string/default_color"
            app:title="@string/modx_glass_color" />

        <SeekBarPreference
            android:defaultValue="240"
            android:max="359"
            app:dependency="modx_liquid"
            app:key="modx_light_angle"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_light_angle" />

        <SeekBarPreference
            android:defaultValue="12"
            android:max="40"
            app:dependency="modx_liquid"
            app:key="modx_pill_margin"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_pill_margin" />

        <SeekBarPreference
            android:defaultValue="100"
            android:max="100"
            app:dependency="modx_liquid"
            app:key="modx_pill_round"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/modx_pill_round" />

        <rikka.material.preference.MaterialSwitchPreference
            app:defaultValue="true"
            app:dependency="modx_liquid"
            app:key="modx_liquid_bg"
            app:summary="@string/modx_liquid_bg_sum"
            app:title="@string/modx_liquid_bg" />

        <rikka.material.preference.MaterialSwitchPreference
            app:dependency="modx_liquid"
            app:key="modx_ios_tab"
            app:summary="@string/modx_ios_tab_sum"
            app:title="@string/modx_ios_tab" />

        <com.wmods.wppenhacer.preference.FeatureColorPreferenceCompat
            app:cpv_showAlphaSlider="true"
            app:dependency="modx_ios_tab"
            app:icon="@drawable/ic_customization_palette_24"
            app:key="modx_tab_color"
            app:summary="@string/default_color"
            app:title="@string/modx_tab_color" />

        <rikka.material.preference.MaterialSwitchPreference
            app:dependency="modx_lg"
            app:key="modx_blur"
            app:summary="@string/modx_blur_sum"
            app:title="@string/modx_blur" />

        <SeekBarPreference
            android:defaultValue="16"
            android:max="40"
            app:dependency="modx_blur"
            app:key="modx_blur_radius"
            app:min="1"
            app:showSeekBarValue="true"
            app:title="@string/modx_blur_radius" />

        <rikka.material.preference.MaterialSwitchPreference
            app:dependency="modx_lg"
            app:key="modx_scroll_blur"
            app:summary="@string/modx_scroll_blur_sum"
            app:title="@string/modx_scroll_blur" />

        <SeekBarPreference
            android:defaultValue="6"
            android:max="20"
            app:dependency="modx_scroll_blur"
            app:key="modx_scroll_blur_strength"
            app:min="1"
            app:showSeekBarValue="true"
            app:title="@string/modx_scroll_blur_strength" />
    </PreferenceCategory>

