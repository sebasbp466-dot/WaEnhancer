            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_strength" />

        <SeekBarPreference
            android:defaultValue="4"
            android:max="30"
            app:dependency="modx_liquid"
            app:key="modx_liquid_blur"
            app:min="1"
            app:showSeekBarValue="true"
            app:title="@string/modx_liquid_blur" />

        <SeekBarPreference
